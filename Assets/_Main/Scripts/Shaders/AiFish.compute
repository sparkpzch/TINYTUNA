#pragma kernel CSMain

struct FishInputGpu
{
    float4 PositionForward;      // xy = position, zw = forward
    float4 TargetSizeState;      // xy = current target, z = size, w = state
    float4 FocusPlayerIndex;     // x = focusingTime, y = isPlayer, z = index
};

struct FishOutputGpu
{
    float4 TargetStateFocus;     // xy = target, z = state, w = focusingTime
};

StructuredBuffer<FishInputGpu> InputFishes;
RWStructuredBuffer<FishOutputGpu> OutputFishes;

int FishCount;
float CurrentTime;
float MaxSearchDistanceSqr;
float MaxVisionCos;
float FocusTargetDuration;
float4 AreaCenter;
float4 AreaSize;

float Hash01(float2 p)
{
    float h = dot(p, float2(127.1, 311.7));
    return frac(sin(h) * 43758.5453123);
}

#define THREAD_GROUP_SIZE 64

// OPTIMIZATION: Use groupshared memory to load chunks of fish data. 
// This reduces global memory reads by a factor of THREAD_GROUP_SIZE (64x less bandwidth).
groupshared FishInputGpu sharedFishes[THREAD_GROUP_SIZE];

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID, uint3 groupThreadID : SV_GroupThreadID)
{
    uint index = id.x;

    FishInputGpu own;
    float2 ownPos = 0;
    float2 ownForward = 0;
    float2 ownTarget = 0;
    float ownSize = 0;
    int ownState = 0;
    float ownFocusTime = 0;

    if (index < FishCount)
    {
        own = InputFishes[index];
        ownPos = own.PositionForward.xy;
        ownForward = normalize(own.PositionForward.zw);
        ownTarget = own.TargetSizeState.xy;
        ownSize = own.TargetSizeState.z;
        ownState = (int)round(own.TargetSizeState.w);
        ownFocusTime = own.FocusPlayerIndex.x;
    }

    float2 newTarget = ownTarget;
    int newState = ownState;
    float focusingTime = ownFocusTime;
    bool foundTarget = false;

    float bestFleeDistance = MaxSearchDistanceSqr;
    float2 fleeTarget = ownTarget;

    float bestPreyDistance = MaxSearchDistanceSqr;
    float2 bestPreyTarget = ownTarget;

    bool foundPlayer = false;
    float bestPlayerDistance = MaxSearchDistanceSqr;
    float2 playerTarget = ownTarget;

    uint numGroups = (FishCount + THREAD_GROUP_SIZE - 1) / THREAD_GROUP_SIZE;

    // OPTIMIZATION: Tiled N-Body approach. Each thread group cooperatively loads a tile of fishes into shared memory.
    for (uint group = 0; group < numGroups; group++)
    {
        // 1. Load a chunk of fishes from global memory into fast shared memory
        uint loadIndex = group * THREAD_GROUP_SIZE + groupThreadID.x;
        if (loadIndex < FishCount)
        {
            sharedFishes[groupThreadID.x] = InputFishes[loadIndex];
        }
        
        // Wait for all threads in the group to finish loading
        GroupMemoryBarrierWithGroupSync();

        if (index < FishCount)
        {
            // 2. Process the loaded chunk
            uint numElements = min(THREAD_GROUP_SIZE, FishCount - group * THREAD_GROUP_SIZE);
            for (uint i = 0; i < numElements; i++)
            {
                uint globalI = group * THREAD_GROUP_SIZE + i;
                if (globalI == index)
                    continue;

                FishInputGpu other = sharedFishes[i];
                float2 otherPos = other.PositionForward.xy;

                float2 delta = otherPos - ownPos;
                float distSq = dot(delta, delta);
                if (distSq > MaxSearchDistanceSqr)
                    continue;

                // OPTIMIZATION: Inlined vision cone check using rsqrt (fast inverse square root) 
                // to avoid expensive normalize() and reuse distSq.
                if (distSq > 0.00001)
                {
                    float invDist = rsqrt(distSq);
                    float dotProduct = dot(ownForward, delta * invDist);
                    if (dotProduct < MaxVisionCos)
                        continue;
                }

                float otherSize = other.TargetSizeState.z;
                bool isPlayer = other.FocusPlayerIndex.y > 0.5;

                if (otherSize > ownSize)
                {
                    if (distSq < bestFleeDistance)
                    {
                        bestFleeDistance = distSq;
                        // OPTIMIZATION: Use rsqrt instead of normalize() for faster vector normalization.
                        float2 fleeDir = -delta * rsqrt(distSq);
                        fleeTarget = ownPos + fleeDir * 20.0;
                        foundTarget = true;
                        newState = 2;
                        focusingTime = CurrentTime + FocusTargetDuration;
                    }
                    continue;
                }

                if (otherSize < ownSize)
                {
                    if (isPlayer)
                    {
                        if (distSq < bestPlayerDistance)
                        {
                            bestPlayerDistance = distSq;
                            playerTarget = otherPos;
                            foundPlayer = true;
                        }
                    }
                    else if (distSq < bestPreyDistance)
                    {
                        bestPreyDistance = distSq;
                        bestPreyTarget = otherPos;
                    }
                }
            }
        }

        GroupMemoryBarrierWithGroupSync();
    }

    if (index >= FishCount)
        return;

    if (foundPlayer)
    {
        newTarget = playerTarget;
        newState = 1;
        foundTarget = true;
        focusingTime = CurrentTime + FocusTargetDuration;
    }
    else if (bestPreyDistance < MaxSearchDistanceSqr)
    {
        newTarget = bestPreyTarget;
        newState = 1;
        foundTarget = true;
        focusingTime = CurrentTime + FocusTargetDuration;
    }
    else if (newState == 2)
    {
        newTarget = fleeTarget;
    }

    float2 center = AreaCenter.xy;
    float2 halfSize = AreaSize.xy * 0.5;

    bool targetOutOfBounds =
        abs(newTarget.x - center.x) > halfSize.x ||
        abs(newTarget.y - center.y) > halfSize.y;

    if (newState == 1 && targetOutOfBounds)
    {
        newTarget = center;
        newState = 0;
        focusingTime = 0.0;
        foundTarget = true;
    }

    if (!foundTarget)
    {
        bool ownOutOfBounds =
            abs(ownPos.x - center.x) > halfSize.x ||
            abs(ownPos.y - center.y) > halfSize.y;

        if (ownOutOfBounds && newState != 1 && newState != 2)
        {
            newTarget = center;
            newState = 0;
            focusingTime = 0.0;
            foundTarget = true;
        }

        if (newState == 1 || newState == 2)
        {
            if (CurrentTime >= focusingTime)
            {
                newState = 0;
                focusingTime = 0.0;
            }
            else
            {
                newTarget = ownPos + ownForward * 20.0;
                foundTarget = true;
            }
        }

        if (newState == 0 && !foundTarget)
        {
            float2 toNewTarget = newTarget - ownPos;
            float closeDistSq = dot(toNewTarget, toNewTarget);
            bool idleTargetOutOfBounds =
                abs(newTarget.x - center.x) > halfSize.x ||
                abs(newTarget.y - center.y) > halfSize.y;

            // OPTIMIZATION: Use squared distance (closeDistSq < 4.0) instead of distance() < 2.0 
            // to avoid expensive sqrt() operations.
            if (closeDistSq < 4.0 || idleTargetOutOfBounds)
            {
                float seedBase = own.FocusPlayerIndex.z * 17.0 + CurrentTime * 11.0;
                float rx = Hash01(ownPos + float2(seedBase, 1.23));
                float ry = Hash01(ownPos + float2(2.34, seedBase));

                newTarget.x = lerp(center.x - halfSize.x, center.x + halfSize.x, rx);
                newTarget.y = lerp(center.y - halfSize.y, center.y + halfSize.y, ry);
            }

            newState = 0;
        }
    }

    FishOutputGpu output;
    output.TargetStateFocus = float4(newTarget.xy, (float)newState, focusingTime);
    OutputFishes[index] = output;
}
